# EmailJS — Copier ce fichier en .env.local et remplir les valeurs
# Ne jamais committer .env.local

# Depuis https://dashboard.emailjs.com/admin
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxx

# Templates distincts pour Contact et Careers
VITE_EMAILJS_CONTACT_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_CAREERS_TEMPLATE_ID=template_xxxxxxx

# Crisp Live Chat — depuis https://app.crisp.chat/settings/websites/ (Settings > Website ID)
VITE_CRISP_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
